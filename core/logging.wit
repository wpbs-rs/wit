/// Provides logging.
@since(version = 0.1.0)
interface logging {
    /// Logs a message at the provided level.
    @since(version = 0.1.0)
    log: func(level: log-level, message: string);

    /// A severity level for a log message.
    @since(version = 0.1.0)
    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }
}
